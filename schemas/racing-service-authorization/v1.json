{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pitgun.io/racing-service-authorization/v1.json",
  "description": "Experimental Racing service control. Native semantic validation, signed attempt binding and exact-runtime replay remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "pitgun.racing-service-authorization/v1"
    },
    "authorized_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "const": "application/json"
        },
        "canonicalization": {
          "const": "jcs-rfc8785"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "media_type",
        "canonicalization",
        "digest"
      ]
    },
    "control_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "runtime_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "player_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "allowed_tire_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,32}$"
      }
    },
    "lap_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128
    },
    "max_decisions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 35
    }
  },
  "required": [
    "schema_version",
    "authorized_input",
    "control_policy",
    "runtime_digest",
    "player_id",
    "allowed_tire_ids",
    "lap_count",
    "max_decisions"
  ]
}
