{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pitgun.io/catalog-release-identity/v1.json",
  "title": "Pitgun Catalog Release Identity V1",
  "description": "Content identity derived from the canonical bytes of one Resource Catalog manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "manifest_digest"],
  "properties": {
    "schema_version": {
      "const": "pitgun.catalog-release-identity/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
